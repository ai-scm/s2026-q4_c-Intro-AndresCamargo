      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" value="&lt;b&gt;C3 – Diagrama de Componentes&lt;/b&gt;&lt;br&gt;Contenedor: Daily Bot API" vertex="1">
          <mxGeometry height="50" width="320" x="500" y="30" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;" value="Daily Bot API&amp;nbsp;&lt;font style=&quot;font-weight: normal&quot;&gt;[Container: Node.js, AWS Lambda + API Gateway]&lt;/font&gt;" vertex="1">
          <mxGeometry height="610" width="1260" x="230" y="140" as="geometry" />
        </mxCell>
        <mxCell id="teams" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Microsoft Teams&lt;/b&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Canal de comunicación con el equipo y canal donde se publican los reportes&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="150" x="-50" y="390" as="geometry" />
        </mxCell>
        <mxCell id="sched" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Daily Scheduler&lt;/b&gt;&lt;div&gt;[Container: EventBridge Scheduler + Lambda]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Se ejecuta por horario y dispara recordatorios y revisión de ausencias&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="160" x="1260" y="20" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;align=center;metaEdit=1;" value="&lt;b&gt;Daily Database&lt;/b&gt;&lt;div&gt;[Container: RDS PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Almacena equipos, miembros, horarios y reportes diarios&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="260" x="725" y="800" as="geometry" />
        </mxCell>
        <mxCell id="notif" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Teams Notifier&lt;/b&gt;&lt;div&gt;[Component: Bot Framework Connector]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Construye y envía a Teams todos los mensajes salientes: tarjeta del formulario, recordatorios, alertas y publicaciones en el canal&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="610" x="550" y="190" as="geometry" />
        </mxCell>
        <mxCell id="handler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Teams Activity Handler&lt;/b&gt;&lt;div&gt;[Component: Bot Framework SDK]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Recibe y autentica lo que llega desde Teams y entrega el reporte enviado al servicio correspondiente&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="160" x="280" y="400" as="geometry" />
        </mxCell>
        <mxCell id="rs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Report Service&lt;/b&gt;&lt;div&gt;[Component: Node.js]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Valida que el reporte esté completo, lo guarda y coordina su publicación y la revisión de estancamiento&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="160" x="540" y="400" as="geometry" />
        </mxCell>
        <mxCell id="det" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Stagnation Detector&lt;/b&gt;&lt;div&gt;[Component: Node.js]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Compara los últimos 3 reportes de una persona y determina si repitió el mismo tema&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="160" x="820" y="400" as="geometry" />
        </mxCell>
        <mxCell id="fu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Daily Follow-up Service&lt;/b&gt;&lt;div&gt;[Component: Node.js]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Determina a quién recordar y, al cierre del día, quién no reportó&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="160" x="1000" y="400" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#78a8d8;fontColor=#000000;arcSize=10;align=center;metaEdit=1;" value="&lt;b&gt;Scheduler Controller&lt;/b&gt;&lt;div&gt;[Component: API Gateway + Lambda handler]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Expone los endpoints internos que invoca el Scheduler y verifica que la llamada sea legítima&lt;/font&gt;&lt;/div&gt;" vertex="1">
